Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 700
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.5
      Show Axes: true
      Show Arrows: false
      Show Names: true
      Frame Timeout: 999999
    - Class: rviz_default_plugins/Map
      Name: 2D Floorplan
      Enabled: true
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: true
      Alpha: 0.7
    - Class: rviz_default_plugins/PointCloud2
      Name: 3D Map
      Enabled: true
      Topic:
        Value: /map_3d
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Intensity Bounds: true
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Live Scan Slice
      Enabled: true
      Topic:
        Value: /pointcloud_3d
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Color Transformer: FlatColor
      Color: 255; 85; 0
    - Class: rviz_default_plugins/LaserScan
      Name: Raw Scan
      Enabled: false
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 0; 170; 255
    - Class: rviz_default_plugins/Marker
      Name: Scan State
      Enabled: true
      Topic:
        Value: /scan_status_marker
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Global Options:
    Background Color: 30; 30; 40
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 12
      Pitch: 0.55
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
