<?xml version="1.0"?>
<robot name="rover_scanner">
  <!-- Base Link Stabilized represents the gravity-leveled base frame (IMU pitch/roll applied) -->
  <link name="base_link_stabilized">
  </link>

  <!-- Dynamic Pitch Joint represents the Nema 17 stepper motor shaft -->
  <!-- It rotates around the Y-axis (pitching motion) -->
  <joint name="nema_pitch_joint" type="revolute">
    <parent link="base_link_stabilized"/>
    <child link="laser"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785398" upper="0.785398" effort="10.0" velocity="5.0"/>
  </joint>

  <!-- Laser Link represents the RPLiDAR C1 active scan plane -->
  <link name="laser">
  </link>
</robot>
